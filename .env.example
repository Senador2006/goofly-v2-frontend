# Copie para `.env` (dev) ou defina no painel do host em produção (Render).
# Nunca commite arquivos .env com valores reais.

VITE_API_GATEWAY_URL=http://localhost:3000/api
VITE_USE_SERVICES_DIRECT=0
VITE_ENV=development

# Produção (exemplo): VITE_API_GATEWAY_URL=/api/v1

VITE_TURNSTILE_SITE_KEY=
VITE_MERCADOPAGO_PUBLIC_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=

# Opcional
# VITE_SENTRY_DSN=
# VITE_DEMO_MODE=true
